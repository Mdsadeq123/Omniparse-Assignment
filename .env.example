# Required: OpenRouter API key used for chat and embedding requests.
# Copy this file to .env and replace the placeholder. Never commit a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter connection and application metadata.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_TITLE=OmniParse

# Models currently used by the application.
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Local storage and retrieval configuration.
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
TOP_K=5
# Lower distances are closer matches. Set 0 to disable filtering.
MAX_RETRIEVAL_DISTANCE=0
MAX_UPLOAD_MB=25

# Optional image captioning through the configured vision model.
VISION_CAPTION_ENABLED=false
